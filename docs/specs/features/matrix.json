{
  "schema_version": 1,
  "product_package": "exacopy-cli",
  "production_packages": [
    "exacopy-cli",
    "exacopy-codec",
    "exacopy-content",
    "exacopy-diff",
    "exacopy-endpoint",
    "exacopy-journal",
    "exacopy-model",
    "exacopy-platform",
    "exacopy-transfer",
    "exacopy-wireguard",
    "exacopy-ssh"
  ],
  "engineering_packages": ["exacopy-testkit", "xtask"],
  "profiles": {
    "minimal": {
      "defaults": false,
      "check_cli": true,
      "feature_statuses": [],
      "purpose": "Compile the mandatory model, integrity, transaction and recovery code without optional features."
    },
    "default": {
      "defaults": true,
      "check_cli": true,
      "feature_statuses": [],
      "purpose": "Check what an ordinary Cargo invocation enables."
    },
    "all-stable": {
      "defaults": true,
      "check_cli": true,
      "feature_statuses": ["stable"],
      "purpose": "Compile all stable optional features for this target together. There are currently none."
    },
    "proof-extraction": {
      "defaults": false,
      "check_cli": false,
      "feature_statuses": ["verification"],
      "purpose": "Compile the minimal workspace with the individual model extraction feature enabled."
    },
    "experimental-apfs-copy": {
      "defaults": false,
      "check_cli": false,
      "feature_statuses": [],
      "exact_features": ["exacopy-cli/experimental-apfs-copy", "exacopy-transfer/experimental-apfs-copy"],
      "targets": ["aarch64-apple-darwin"],
      "purpose": "Compile the opt-in transfer policies, native runtime, and managed APFS regressions."
    },
    "experimental-windows-diff": {
      "defaults": false,
      "check_cli": false,
      "feature_statuses": [],
      "exact_features": [
        "exacopy-cli/experimental-windows-diff",
        "exacopy-platform/experimental-windows-read"
      ],
      "targets": [
        "x86_64-pc-windows-msvc"
      ],
      "purpose": "Compile the explicitly selected local NTFS read-only CLI comparison without staging or fixture features."
    },
    "experimental-windows-copy": {
      "defaults": false,
      "check_cli": false,
      "feature_statuses": [],
      "exact_features": ["exacopy-platform/experimental-windows-copy", "exacopy-platform/windows-read-fixture"],
      "targets": ["x86_64-pc-windows-msvc"],
      "purpose": "Compile the optional private NTFS staging capability and Windows qualification fixtures."
    },
    "experimental-wireguard-protocol": {
      "defaults": false,
      "check_cli": false,
      "feature_statuses": [],
      "exact_features": ["exacopy-wireguard/experimental-protocol"],
      "purpose": "Check the in-memory WireGuard packet adapter in a separate workspace profile on each CI target."
    },
    "experimental-ssh": {
      "defaults": false,
      "check_cli": false,
      "feature_statuses": [],
      "exact_features": ["exacopy-ssh/experimental-ssh"],
      "purpose": "Compile the opt-in read-only SSH/SFTP adapter for dependency review and synthetic in-process tests."
    },
    "development-all": {
      "defaults": true,
      "check_cli": false,
      "feature_statuses": ["stable", "experimental", "verification"],
      "purpose": "Compile all features applicable to the target together with the default workspace."
    }
  },
  "features": {
    "exacopy-ssh": {
      "experimental-ssh": {
        "status": "experimental",
        "enables": [
          "dep:bytes",
          "dep:exacopy-endpoint",
          "dep:hmac",
          "dep:sha1",
          "dep:russh",
          "dep:russh-sftp",
          "dep:tokio",
          "dep:tokio-util",
          "dep:zeroize"
        ],
        "resolution_probe": [
          "bytes",
          "exacopy-endpoint",
          "hmac",
          "sha1",
          "russh",
          "russh-sftp",
          "tokio",
          "tokio-util",
          "zeroize"
        ],
        "purpose": "Enable the caller-routed, pinned-host, read-only SSH/SFTP library without enabling a product workflow."
      }
    },
    "exacopy-cli": {
      "experimental-windows-diff": {
        "status": "experimental",
        "targets": [
          "x86_64-pc-windows-msvc"
        ],
        "enables": [
          "dep:exacopy-diff",
          "dep:exacopy-endpoint",
          "dep:exacopy-platform",
          "exacopy-platform/experimental-windows-read"
        ],
        "resolution_probe": [
          "exacopy-diff",
          "exacopy-endpoint",
          "exacopy-platform",
          "windows-sys"
        ],
        "purpose": "Build the opt-in local NTFS read-only CLI comparison."
      },
      "experimental-apfs-copy": {
        "status": "experimental",
        "targets": [
          "aarch64-apple-darwin"
        ],
        "enables": [
          "dep:exacopy-content",
          "dep:exacopy-journal",
          "dep:exacopy-model",
          "dep:exacopy-transfer",
          "exacopy-transfer/experimental-apfs-copy"
        ],
        "resolution_probe": [
          "exacopy-content",
          "exacopy-journal",
          "exacopy-transfer"
        ],
        "purpose": "Compose the experimental managed APFS copy and recovery entry points with the mounted adapter."
      }
    },
    "exacopy-wireguard": {
      "experimental-protocol": {
        "status": "experimental",
        "enables": ["dep:boringtun", "dep:rustix"],
        "resolution_probe": ["boringtun"],
        "purpose": "Enable only the exact BoringTun protocol backend for the default-off in-memory packet adapter."
      }
    },
    "exacopy-model": {
      "proof-extraction": {
        "status": "verification",
        "enables": ["dep:hax-lib"],
        "resolution_probe": ["hax-lib"],
        "purpose": "Expose annotations for the pinned hax extraction path."
      }
    },
    "exacopy-platform": {
      "experimental-windows-copy": {
        "status": "experimental",
        "targets": ["x86_64-pc-windows-msvc"],
        "enables": ["dep:exacopy-endpoint", "dep:exacopy-model", "dep:windows-sys"],
        "resolution_probe": ["exacopy-endpoint", "exacopy-model", "windows-sys"],
        "purpose": "Expose held-directory Windows private stage creation, bounded writes, confirmed file flush and close, and independent read-back."
      },
      "experimental-windows-read": {
        "status": "experimental",
        "targets": [
          "x86_64-pc-windows-msvc"
        ],
        "enables": [
          "dep:exacopy-endpoint",
          "dep:windows-sys"
        ],
        "resolution_probe": [
          "exacopy-endpoint",
          "windows-sys"
        ],
        "purpose": "Admit read-only held regular files through bounded literal drive paths."
      },
      "windows-read-fixture": {
        "status": "experimental",
        "targets": ["x86_64-pc-windows-msvc"],
        "enables": [],
        "resolution_probe": [],
        "purpose": "Compile private held-directory and exact comparison fixtures. The fixture uses its own test dependencies."
      }
    },
    "exacopy-transfer": {
      "experimental-apfs-copy": {
        "status": "experimental",
        "targets": ["aarch64-apple-darwin"],
        "enables": [
          "dep:blake3",
          "dep:ed25519-dalek",
          "dep:exacopy-content",
          "dep:exacopy-endpoint",
          "dep:exacopy-journal",
          "dep:exacopy-model",
          "dep:minicbor"
        ],
        "resolution_probe": [
          "blake3", "ed25519-dalek", "exacopy-content", "exacopy-endpoint", "exacopy-journal",
          "exacopy-model", "minicbor"
        ],
        "purpose": "Enable the managed APFS operation policies, canonical records, and recovery decisions."
      }
    }
  },
  "production_dependencies": {
    "hmac": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Match OpenSSH v1 hashed host labels through bounded HMAC-SHA1; never an SSH authentication algorithm."
    },
    "sha1": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Supply only the digest in OpenSSH hashed-host label compatibility; host-key fingerprints remain SHA256."
    },
    "apfs-mounted": {
      "default_features": false,
      "features": [],
      "purpose": "Perform descriptor-scoped mounted APFS operations under the macOS adapter contract."
    },
    "base64": {
      "default_features": false,
      "features": ["alloc"],
      "purpose": "Encode the bounded raw-byte fields of public integrity manifests."
    },
    "bytes": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Pass bounded SFTP frames to the upstream packet codec and hold its encoded responses."
    },
    "russh": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Perform SSH key exchange, authenticate one pinned peer on a caller-owned stream, and request its SFTP subsystem.",
      "feature_additions": {
        "exacopy-ssh": [
          "ring"
        ]
      }
    },
    "russh-sftp": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Encode and decode admitted SFTP v3 requests and preserve raw file and handle bytes.",
      "feature_additions": {
        "exacopy-ssh": [
          "raw-string"
        ]
      }
    },
    "tokio": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Supply async SSH stream I/O, bounded timeouts and synchronization with a synthetic in-process peer.",
      "feature_additions": {
        "exacopy-ssh": [
          "io-util",
          "macros",
          "rt",
          "sync",
          "time"
        ]
      }
    },
    "tokio-util": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Fence the owned SSH byte stream when an operation fails or its owner is dropped.",
      "feature_additions": {
        "exacopy-ssh": [
          "rt"
        ]
      }
    },
    "boringtun": {
      "default_features": false,
      "features": [],
      "optional": true,
      "purpose": "Supply WireGuard handshake and authenticated packet operations for the isolated experimental adapter."
    },
    "blake3": {
      "default_features": false,
      "features": [],
      "optional_targets": {
        "exacopy-transfer": ["cfg(target_os = \"macos\")"]
      },
      "purpose": "Source stream and independent stage read-back digests, and content bindings."
    },
    "clap": {
      "default_features": false,
      "features": ["error-context", "help", "std", "usage"],
      "purpose": "Parse the native CLI argument grammar and generate command help and usage."
    },
    "crc32c": {
      "default_features": true,
      "features": [],
      "purpose": "Detect torn or corrupt journal frames before authenticated record decoding."
    },
    "ed25519-dalek": {
      "default_features": false,
      "features": ["zeroize"],
      "optional_targets": {
        "exacopy-transfer": ["cfg(target_os = \"macos\")"]
      },
      "purpose": "Sign and verify transaction journal records and receipts."
    },
    "getrandom": {
      "default_features": false,
      "features": ["std"],
      "purpose": "Obtain the fixed-width stage-attempt entropy prefix from the macOS system random source."
    },
    "hax-lib": {
      "default_features": false,
      "features": ["macros"],
      "optional": true,
      "purpose": "Annotate the model for proof extraction."
    },
    "libc": {
      "default_features": true,
      "features": [],
      "purpose": "Access macOS functions and constants unavailable through the safe platform wrapper."
    },
    "minicbor": {
      "default_features": false,
      "features": [],
      "optional_targets": {
        "exacopy-transfer": ["cfg(target_os = \"macos\")"]
      },
      "purpose": "Read and write bounded, explicitly encoded journal records and receipts."
    },
    "rustix": {
      "default_features": true,
      "features": ["fs", "process"],
      "optional_targets": {
        "exacopy-wireguard": ["cfg(any(target_os = \"linux\", target_os = \"macos\"))"]
      },
      "feature_additions": {
        "exacopy-cli": ["rand"],
        "exacopy-wireguard": ["time"],
        "exacopy-platform": {
          "cfg(target_os = \"macos\")": ["try_close"]
        }
      },
      "purpose": "Perform capability-scoped filesystem operations and obtain required OS process and entropy data."
    },
    "serde": {
      "default_features": true,
      "features": ["derive"],
      "purpose": "Describe stable field and enum names for CLI reports."
    },
    "chrono": {
      "default_features": false,
      "features": ["alloc"],
      "purpose": "Parse and format public Plan UTC timestamps without clock or timezone database support."
    },
    "serde_json": {
      "default_features": true,
      "features": [],
      "feature_additions": {"exacopy-codec": ["raw_value"]},
      "purpose": "Serialize the versioned CLI report on all command targets."
    },
    "uuid": {
      "default_features": false,
      "features": [],
      "purpose": "Represent and encode fixed-size transaction identities."
    },
    "windows-sys": {
      "default_features": false,
      "features": [],
      "optional": true,
      "feature_additions": {
        "exacopy-platform": [
          "Wdk_Foundation", "Wdk_Storage_FileSystem", "Win32_Security",
          "Win32_Storage_FileSystem", "Win32_System_IO"
        ]
      },
      "purpose": "Provide the Windows ABI for experimental private staging beneath an authorized NTFS directory."
    },
    "zeroize": {
      "default_features": false,
      "features": [],
      "optional_consumers": ["exacopy-ssh"],
      "purpose": "Clear owned copies of signing key material and SSH password input."
    }
  },
  "cli_graph_groups": {
    "command_line": ["anstyle@1.0.14", "clap@4.6.10", "clap_builder@4.6.10", "clap_lex@1.1.2"],
    "reporting": [
      "exacopy-cli@0.1.0", "itoa@1.0.19", "memchr@2.8.3", "proc-macro2@1.0.107", "quote@1.0.47",
      "serde@1.0.229", "serde_core@1.0.229", "serde_derive@1.0.229", "serde_json@1.0.154", "syn@3.0.10", "unicode-ident@1.0.27", "zmij@1.0.23"
    ],
    "local_comparison": [
      "bitflags@2.13.2", "exacopy-diff@0.1.0", "exacopy-endpoint@0.1.0", "exacopy-model@0.1.0",
      "exacopy-platform@0.1.0", "rustix@1.1.6", "uuid@1.29.3"
    ],
    "linux_verified_transfer": [
      "arrayvec@0.7.8", "blake3@1.8.7", "block-buffer@0.10.4", "cc@1.11.2", "cfg-if@1.0.5", "constant_time_eq@0.4.2",
      "cpufeatures@0.2.17", "cpufeatures@0.3.1", "crc32c@0.6.9", "crypto-common@0.1.7", "curve25519-dalek@4.1.3", "curve25519-dalek-derive@0.1.1",
      "digest@0.10.7", "ed25519@2.2.3", "ed25519-dalek@2.2.0", "exacopy-content@0.1.0", "exacopy-journal@0.1.0",
      "exacopy-transfer@0.1.0", "find-msvc-tools@0.1.15", "generic-array@0.14.7", "linux-raw-sys@0.12.1",
      "minicbor@2.3.1", "rustc_version@0.4.1", "semver@1.0.28", "sha2@0.10.9", "shlex@2.0.1", "signature@2.2.0", "syn@2.0.119", "subtle@2.6.1",
      "typenum@1.20.1", "version_check@0.9.5", "zeroize@1.9.2"
    ],
    "linux_manifests": ["autocfg@1.5.1", "base64@0.23.1", "chrono@0.4.45", "exacopy-codec@0.1.0", "num-traits@0.2.19"],
    "macos_io": ["apfs-mounted@0.1.0", "cfg-if@1.0.5", "errno@0.3.15", "getrandom@0.4.3", "libc@0.2.191"]
  },
  "targets": {
    "x86_64-unknown-linux-gnu": {
      "cli": {
        "status": "local",
        "diff": "local regular files",
        "copy_and_recovery": "Linux verified single-file transfer and recovery",
        "manifest_and_verification": "Unsigned single-file baseline creation and read-only content verification"
      },
      "cli_graph_groups": ["command_line", "reporting", "local_comparison", "linux_verified_transfer", "linux_manifests"],
      "rustix_features": ["alloc", "default", "fs", "process", "rand", "std"]
    },
    "aarch64-apple-darwin": {
      "cli": {
        "status": "local",
        "diff": "regular files in managed APFS directories with --managed-macos",
        "copy_and_recovery": "unsupported through the CLI"
      },
      "cli_graph_groups": ["command_line", "reporting", "local_comparison", "macos_io"],
      "rustix_features": ["alloc", "default", "fs", "process", "std", "try_close"]
    },
    "x86_64-pc-windows-msvc": {
      "cli": {
        "status": "explicit-refusal",
        "diff": "experimental NTFS with experimental-windows-diff and --local-ntfs",
        "copy_and_recovery": "unsupported"
      },
      "cli_graph_groups": ["command_line", "reporting"],
      "rustix_features": []
    }
  },
  "other_targets": "No CI build or release qualification is asserted for other triples.",
  "unimplemented_capabilities": [
    "GUI", "network transfer", "VPN", "Android", "cloud storage", "backup repositories",
    "specialized document processing", "experimental I/O backends"
  ]
}
