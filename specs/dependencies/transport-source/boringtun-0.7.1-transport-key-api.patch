diff --git a/src/noise/transport_key.rs b/src/noise/transport_key.rs
new file mode 100644
index 0000000..94d9bce
--- /dev/null
+++ b/src/noise/transport_key.rs
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+use std::fmt;
+use std::net::IpAddr;
+use std::num::NonZeroU64;
+use std::time::Duration;
+
+use super::errors::WireGuardError;
+use super::session::Session;
+use super::{Tunn, TunnResult, N_SESSIONS};
+
+/// Identifies a transport key pair for the lifetime of its owning tunnel.
+///
+/// Compare these identifiers only within the same [`Tunn`]. They are local
+/// observations and have no relationship to the cyclic wire session indices.
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct TransportKeyId(NonZeroU64);
+
+/// The authenticated handshake event that installed a transport key pair.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub enum TransportKeyOrigin {
+    /// A response matched the active outgoing initiation.
+    CurrentInitiation,
+    /// A delayed response matched the previous outgoing initiation.
+    PreviousInitiation,
+    /// An authenticated incoming initiation installed a responder key pair.
+    IncomingInitiation,
+}
+
+/// Local observations about one retained transport key pair, excluding key bytes.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub struct TransportKey {
+    /// An identifier assigned once when this pair was installed.
+    pub id: TransportKeyId,
+    /// The authenticated event that established this pair.
+    pub origin: TransportKeyOrigin,
+    /// Age measured from before establishment using the tunnel clock.
+    ///
+    /// An unavailable clock or a sample before establishment has no age.
+    pub age: Option<Duration>,
+    /// Counter that the next send under this pair would consume, including keepalives.
+    pub next_send_counter: u64,
+    /// Number of records authenticated and marked in this pair's replay window.
+    ///
+    /// This counts keepalives and records whose inner bytes are later rejected.
+    pub received_packets: u64,
+}
+
+/// The actual transport key pair used during one tunnel operation.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub enum TransportKeyUse {
+    /// A transport record was encrypted, including an empty keepalive.
+    Sent(TransportKeyId),
+    /// A record passed authentication and was marked in its replay window.
+    ///
+    /// The accompanying packet result still governs inner packet delivery.
+    Received(TransportKeyId),
+}
+
+/// A packet operation and the exact transport key pair it used, if any.
+#[must_use]
+pub struct TransportKeyResult<'a> {
+    /// Existing packet outcome and associated bytes.
+    pub result: TunnResult<'a>,
+    /// A transport authentication or encryption event from this operation.
+    ///
+    /// Unauthenticated input, handshake control packets, and idle returns have no
+    /// key use. A responder handshake can install a pair without using it here.
+    pub key_use: Option<TransportKeyUse>,
+}
+
+impl fmt::Debug for TransportKeyResult<'_> {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("TransportKeyResult")
+            .field("key_use", &self.key_use)
+            .finish_non_exhaustive()
+    }
+}
+
+pub(super) struct RetainedKey {
+    pub(super) session: Session,
+    pub(super) id: TransportKeyId,
+    origin: TransportKeyOrigin,
+    establishing_at: Option<Duration>,
+}
+
+impl RetainedKey {
+    fn observe(&self, now: Option<Duration>) -> TransportKey {
+        let (_, received_packets) = self.session.current_packet_cnt();
+        TransportKey {
+            id: self.id,
+            origin: self.origin,
+            age: now.and_then(|now| now.checked_sub(self.establishing_at?)),
+            next_send_counter: self.session.next_sending_counter(),
+            received_packets,
+        }
+    }
+}
+
+impl Tunn {
+    /// Observes the exact key pair that an immediate encapsulation would select.
+    ///
+    /// Incoming authenticated packets can change selection. Query again after a
+    /// tunnel operation before relying on this observation. Because the slot ring
+    /// is reused, a selected responder pair may still have received zero
+    /// authenticated records. Selection alone supplies no confirmation.
+    pub fn current_transport_key(&self) -> Option<TransportKey> {
+        let key = self.sessions[self.current % N_SESSIONS].as_ref()?;
+        Some(key.observe(self.timers.transport_clock()))
+    }
+
+    /// Observes the newest installed key pair among the retained slots.
+    ///
+    /// For a responder, an authenticated initiation can install a new pair before
+    /// this tunnel selects it for sending.
+    pub fn newest_transport_key(&self) -> Option<TransportKey> {
+        let key = self.sessions.iter().flatten().max_by_key(|key| key.id)?;
+        Some(key.observe(self.timers.transport_clock()))
+    }
+
+    /// Observes the retained pair identified by a result from this tunnel.
+    pub fn transport_key(&self, id: TransportKeyId) -> Option<TransportKey> {
+        let key = self.sessions.iter().flatten().find(|key| key.id == id)?;
+        Some(key.observe(self.timers.transport_clock()))
+    }
+
+    /// Encapsulates with an attestation of the exact transport key used.
+    ///
+    /// The same queue behavior and buffer requirements as [Self::encapsulate] apply.
+    pub fn encapsulate_with_transport_key<'a>(
+        &mut self,
+        src: &[u8],
+        dst: &'a mut [u8],
+    ) -> TransportKeyResult<'a> {
+        self.observe_transport_use(move |tunnel| tunnel.encapsulate(src, dst))
+    }
+
+    /// Processes input with an attestation of the transport key used.
+    ///
+    /// This also attests send keys if processing input produces an encrypted
+    /// confirmation or consumes queued data on empty input.
+    pub fn decapsulate_with_transport_key<'a>(
+        &mut self,
+        src_addr: Option<IpAddr>,
+        datagram: &[u8],
+        dst: &'a mut [u8],
+    ) -> TransportKeyResult<'a> {
+        self.observe_transport_use(move |tunnel| tunnel.decapsulate(src_addr, datagram, dst))
+    }
+
+    /// Updates timers with an attestation of the key used for an encrypted keepalive.
+    pub fn update_timers_with_transport_key<'a>(
+        &mut self,
+        dst: &'a mut [u8],
+    ) -> TransportKeyResult<'a> {
+        self.observe_transport_use(move |tunnel| tunnel.update_timers(dst))
+    }
+
+    fn observe_transport_use<'a>(
+        &mut self,
+        operation: impl FnOnce(&mut Self) -> TunnResult<'a>,
+    ) -> TransportKeyResult<'a> {
+        self.last_transport_key_use = None;
+        let result = operation(self);
+        TransportKeyResult {
+            result,
+            key_use: self.last_transport_key_use.take(),
+        }
+    }
+
+    /// Discards retained key pairs that the caller cannot authorize for further use.
+    ///
+    /// The callback runs once per occupied slot, at most eight times, with a
+    /// single clock sample. Other slots and their replay windows are preserved.
+    /// Removing the selected slot leaves no selected send key until the tunnel
+    /// selects a retained or newly established pair.
+    ///
+    /// For pre-operation fencing, call this immediately before processing input,
+    /// output or timers under the same exclusive ownership. New handshakes may
+    /// install a key during those operations. Check any applicable authority
+    /// again before releasing output. This method preserves the legacy packet
+    /// queue. A caller requiring no queue must check for an eligible selected
+    /// pair before submitting application bytes.
+    pub fn retain_transport_keys(&mut self, mut retain: impl FnMut(TransportKey) -> bool) {
+        let now = self.timers.transport_clock();
+        for slot in &mut self.sessions {
+            if slot.as_ref().is_some_and(|key| !retain(key.observe(now))) {
+                *slot = None;
+            }
+        }
+    }
+
+    pub(super) fn next_transport_key_id(&self) -> Result<TransportKeyId, WireGuardError> {
+        self.last_transport_key_id
+            .checked_add(1)
+            .and_then(NonZeroU64::new)
+            .map(TransportKeyId)
+            .ok_or(WireGuardError::ConnectionExpired)
+    }
+
+    pub(super) fn install_transport_key(
+        &mut self,
+        session: Session,
+        id: TransportKeyId,
+        origin: TransportKeyOrigin,
+        establishing_at: Option<Duration>,
+    ) {
+        let slot = session.local_index() % N_SESSIONS;
+        self.sessions[slot] = Some(RetainedKey {
+            session,
+            id,
+            origin,
+            establishing_at,
+        });
+        self.last_transport_key_id = id.0.get();
+    }
+}
